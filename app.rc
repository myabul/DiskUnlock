#include <winres.h>

1001 ICON "app.ico"

// Resource id 1 = CREATEPROCESS_MANIFEST_RESOURCE_ID, type 24 = RT_MANIFEST.
// Loader behaviour (elevation + DPI awareness) depends on this line existing.
1 24 "manifest.xml"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 2,0,0,0
 PRODUCTVERSION 2,0,0,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",  "DiskUnlock Studio"
            VALUE "FileDescription", "Physical disk security / ATA-SAT-NVMe low-level tool"
            VALUE "FileVersion",  "2.0.0.0"
            VALUE "InternalName", "DiskUnlocker"
            VALUE "LegalCopyright", "2026"
            VALUE "OriginalFilename", "DiskUnlocker.exe"
            VALUE "ProductName",  "DiskUnlock Studio"
            VALUE "ProductVersion", "2.0.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
